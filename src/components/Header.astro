---
interface Props {
  showLab?: boolean;
}
const { showLab = false } = Astro.props;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">Varun,</a>
    <nav aria-label="Main">
      <ul>
        <li><a href="/blog/">Writing</a></li>
        {showLab && <li><a href="/lab/">Lab</a></li>}
        <li><a href="/resume.pdf">Résumé</a></li>
      </ul>
    </nav>
  </div>
  <slot name="cord" />
</header>

<style>
  .site-header { position: relative; }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 22px;
    padding-bottom: 22px;
  }
  .brand {
    font-family: var(--head);
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  ul { display: flex; gap: 22px; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--ink); font-weight: 600; text-decoration: none; }
  nav a:hover { text-decoration: underline; text-underline-offset: 4px; }
</style>
