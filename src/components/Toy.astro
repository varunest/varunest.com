---
import Pendulum from "./toys/Pendulum.astro";
import Bookshelf from "./toys/Bookshelf.astro";
import ServerRack from "./toys/ServerRack.astro";
import type { ToyName } from "../lib/toy";

interface Props {
  name: ToyName;
  context?: { title: string; rating?: string; others?: { title: string; rating?: string }[] };
}
const { name, context } = Astro.props;
---
<aside class="toy" aria-label="A small toy to play with">
  {name === "pendulum" && <Pendulum />}
  {name === "bookshelf" && context && <Bookshelf current={context} others={context.others ?? []} />}
  {name === "server-rack" && <ServerRack />}
</aside>

<style>
  .toy {
    margin: 0 0 28px;
    padding: 14px;
    background: var(--card);
    border: var(--stroke) solid var(--line);
    border-radius: var(--radius);
    min-width: 0;
  }
</style>
