<button class="cord" type="button" aria-label="Switch between light and dark"></button>

<script>
  import { applyTheme, writeTheme, type Theme } from "../lib/theme";

  const PULL_MAX = 70;
  const PULL_THRESHOLD = 20;
  const cord = document.querySelector<HTMLButtonElement>(".cord");

  function currentTheme(): Theme {
    return document.documentElement.dataset.theme === "dark" ? "dark" : "light";
  }

  function toggle() {
    const next: Theme = currentTheme() === "dark" ? "light" : "dark";
    applyTheme(next);
    let storage: Storage | null = null;
    try {
      storage = window.localStorage;
    } catch {
      // blocked
    }
    writeTheme(storage, next);
    document.dispatchEvent(new CustomEvent("themechange", { detail: { theme: next } }));
  }

  function nudge(el: HTMLElement) {
    el.classList.remove("sway", "nudge");
    void el.offsetWidth;
    el.classList.add("nudge");
  }

  if (cord) {
    let startY: number | null = null;
    let pointerId: number | null = null;

    cord.classList.add("sway");
    cord.addEventListener("pointerdown", (e) => {
      if (!e.isPrimary || e.button !== 0) return;
      startY = e.clientY;
      pointerId = e.pointerId;
      cord.classList.add("pulling");
      cord.setPointerCapture(e.pointerId);
    });
    cord.addEventListener("pointermove", (e) => {
      if (startY === null || e.pointerId !== pointerId) return;
      const pull = Math.max(0, Math.min(PULL_MAX, e.clientY - startY));
      cord.style.setProperty("--pull", `${pull}px`);
    });
    const release = (e: PointerEvent) => {
      if (startY === null || e.pointerId !== pointerId) return;
      const dy = e.clientY - startY;
      startY = null;
      pointerId = null;
      cord.classList.remove("pulling");
      cord.style.setProperty("--pull", "0px");
      if (e.type === "pointerup" && dy > PULL_THRESHOLD) toggle();
      else if (e.type === "pointerup") nudge(cord);
    };
    cord.addEventListener("pointerup", release);
    cord.addEventListener("pointercancel", release);
    // Pointer clicks never toggle; keyboard Enter/Space arrive as click with detail 0.
    cord.addEventListener("click", (e) => {
      if (e.detail === 0) toggle();
    });
    cord.addEventListener("animationend", () => cord.classList.remove("sway", "nudge"));
  }
</script>

<style>
  .cord {
    position: absolute;
    top: 0;
    right: 14px;
    width: 34px;
    height: calc(74px + var(--pull, 0px));
    padding: 0;
    border: 0;
    background: none;
    cursor: grab;
    touch-action: none;
    transform-origin: 50% 0;
    transition: height 0.45s cubic-bezier(0.3, 2.2, 0.5, 1);
  }
  .cord.sway { animation: sway 2.2s ease-in-out 0.7s 2; }
  .cord:hover { height: calc(84px + var(--pull, 0px)); }
  .cord.pulling { transition: none; cursor: grabbing; }
  .cord.nudge { animation: nudge 0.5s ease-in-out; }
  .cord::before {
    content: "";
    position: absolute;
    left: 16px;
    top: 0;
    bottom: 22px;
    width: 2px;
    background: var(--ink);
  }
  .cord::after {
    content: "☾";
    position: absolute;
    left: 1px;
    bottom: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--pop2);
    border: 2px solid var(--ink);
    color: #0f2a2e;
    font-size: 17px;
    line-height: 28px;
    text-align: center;
    box-shadow: 0 3px 0 var(--ink);
  }
  :global(:root[data-theme="dark"]) .cord::after { content: "☀"; }
  :global(.no-js) .cord { display: none; }

  @keyframes sway {
    0%, 100% { transform: rotate(0); }
    25% { transform: rotate(7deg); }
    75% { transform: rotate(-7deg); }
  }
  @keyframes nudge {
    30% { transform: translateY(7px); }
    60% { transform: translateY(-2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cord, .cord.sway, .cord.nudge { animation: none; transition: none; }
    .cord:hover { height: calc(74px + var(--pull, 0px)); }
  }
</style>
