---
---
<div class="pendulum-toy">
  <canvas
    width="440"
    height="340"
    role="application"
    aria-label="A pendulum. Press the left and right arrow keys to nudge it, or drag the weight."
  ></canvas>
  <svg class="static" viewBox="0 0 440 340" aria-hidden="true" focusable="false">
    <g stroke="var(--ink)" stroke-linecap="round" fill="none">
      <line x1="140" y1="24" x2="300" y2="24" stroke-width="4" />
      <line x1="220" y1="24" x2="371" y2="184" stroke-width="3" />
      <circle cx="371" cy="184" r="30" fill="var(--pop)" stroke-width="3" />
    </g>
  </svg>
</div>

<script>
  import { stepPendulum } from "../../lib/toy";

  const W = 440;
  const H = 340;
  const PIVOT_X = 220;
  const PIVOT_Y = 24;
  const LENGTH = 220;
  const BOB_R = 30;
  const NUDGE = 0.06;
  const GRAB_PX = 40; // CSS px around the bob that start a drag; elsewhere the page scrolls
  const REST = 0.0005; // |angle| and |velocity| below this: stop the loop
  const DPR = Math.min(2, window.devicePixelRatio || 1);

  const canvas = document.querySelector<HTMLCanvasElement>(".pendulum-toy canvas");
  const ctx = canvas?.getContext("2d");
  if (canvas && ctx) {
    canvas.tabIndex = 0;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    let last = 0;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let state = { angle: 0.8, velocity: 0 };
    let dragging = false;
    let raf = 0;
    let onScreen = true;

    const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

    function draw() {
      ctx!.clearRect(0, 0, W, H);
      const x = PIVOT_X + LENGTH * Math.sin(state.angle);
      const y = PIVOT_Y + LENGTH * Math.cos(state.angle);
      ctx!.strokeStyle = css("--ink");
      ctx!.lineCap = "round";
      ctx!.lineWidth = 4;
      ctx!.beginPath();
      ctx!.moveTo(PIVOT_X - 80, PIVOT_Y);
      ctx!.lineTo(PIVOT_X + 80, PIVOT_Y);
      ctx!.stroke();
      ctx!.lineWidth = 3;
      ctx!.beginPath();
      ctx!.moveTo(PIVOT_X, PIVOT_Y);
      ctx!.lineTo(x, y);
      ctx!.stroke();
      ctx!.fillStyle = css("--pop");
      ctx!.beginPath();
      ctx!.arc(x, y, BOB_R, 0, Math.PI * 2);
      ctx!.fill();
      ctx!.stroke();
    }

    function frame(now: number) {
      raf = 0;
      // Real elapsed time in 60fps frames, clamped so a stalled tab does not jump.
      const dt = last ? Math.min(3, Math.max(0.1, (now - last) / (1000 / 60))) : 1;
      last = now;
      if (!dragging) state = stepPendulum(state, dt);
      if (!dragging && Math.abs(state.angle) < REST && Math.abs(state.velocity) < REST) {
        state = { angle: 0, velocity: 0 };
        draw();
        last = 0; // idle: nothing schedules another frame until a drag, nudge or theme change
        return;
      }
      draw();
      schedule();
    }

    function shouldRun() {
      return !reduced.matches && onScreen && !document.hidden;
    }
    function schedule() {
      if (!raf && shouldRun()) raf = requestAnimationFrame(frame);
    }
    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      last = 0;
    }
    function sync() {
      if (shouldRun()) schedule();
      else {
        stop();
        draw();
      }
    }

    function nudge(by: number) {
      state = { angle: state.angle, velocity: state.velocity + by };
      schedule();
      if (!shouldRun()) {
        // No loop: apply the nudge as a visible displacement so the drawing still responds.
        state = { angle: state.angle + by * 8, velocity: 0 };
        draw();
      }
    }

    canvas.addEventListener("pointerdown", (e) => {
      const r = canvas.getBoundingClientRect();
      const scale = W / r.width; // CSS px -> canvas units
      const bx = PIVOT_X + LENGTH * Math.sin(state.angle);
      const by = PIVOT_Y + LENGTH * Math.cos(state.angle);
      const dx = (e.clientX - r.left) * scale - bx;
      const dy = (e.clientY - r.top) * scale - by;
      if (Math.hypot(dx, dy) > GRAB_PX * scale) return; // away from the bob: let the page scroll
      dragging = true;
      canvas.setPointerCapture(e.pointerId);
      schedule();
    });
    canvas.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const r = canvas.getBoundingClientRect();
      state = {
        angle: Math.atan2(((e.clientX - r.left) * W) / r.width - PIVOT_X, ((e.clientY - r.top) * H) / r.height - PIVOT_Y),
        velocity: 0,
      };
      if (!shouldRun()) draw();
    });
    const release = () => {
      dragging = false;
      schedule();
    };
    canvas.addEventListener("pointerup", release);
    canvas.addEventListener("pointercancel", release);
    canvas.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
        e.preventDefault();
        nudge(e.key === "ArrowLeft" ? -NUDGE : NUDGE);
      }
    });

    document.addEventListener("themechange", () => {
      draw();
      schedule();
    });
    document.addEventListener("visibilitychange", sync);
    reduced.addEventListener("change", sync);
    new IntersectionObserver((entries) => {
      onScreen = entries[entries.length - 1]?.isIntersecting ?? true;
      sync();
    }).observe(canvas);

    draw();
    sync();
  }
</script>

<style>
  .pendulum-toy { display: grid; place-items: center; background: var(--bg); border-radius: 10px; }
  canvas { width: 100%; max-width: 440px; height: auto; aspect-ratio: 440 / 340; touch-action: pan-y; cursor: grab; border-radius: 10px; }
  canvas:focus-visible { outline: 3px solid var(--primary); outline-offset: 2px; }
  .static { display: none; width: 100%; max-width: 440px; height: auto; }
  :global(.no-js) canvas { display: none; }
  :global(.no-js) .static { display: block; }
</style>
