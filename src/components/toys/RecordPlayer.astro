---
interface Props { inert?: boolean }
const { inert = false } = Astro.props;
const Tag = inert ? "span" : "button";
---
<div class="toy-record">
  <Tag class="player" type={inert ? undefined : "button"} disabled={inert ? undefined : true} aria-pressed={inert ? undefined : "false"} aria-label={inert ? undefined : "Play a record"}>
    <svg viewBox="0 0 150 110" aria-hidden="true">
      <rect x="8" y="14" width="134" height="88" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="3" />
      <g class="disc">
        <circle cx="62" cy="58" r="36" fill="#1b1b1b" stroke="var(--ink)" stroke-width="2" />
        <circle cx="62" cy="58" r="26" fill="none" stroke="#3a3a3a" stroke-width="1.5" />
        <circle cx="62" cy="58" r="11" fill="var(--pop)" />
        <circle cx="56" cy="52" r="2" fill="#fff" />
      </g>
      <circle cx="62" cy="58" r="2.5" fill="var(--ink)" />
      <g class="arm"><path d="M126 26L118 66L104 78" stroke="var(--ink)" stroke-width="4" fill="none" stroke-linecap="round" /><circle cx="126" cy="26" r="7" fill="var(--pop2)" stroke="var(--ink)" stroke-width="2.5" /></g>
    </svg>
  </Tag>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>(".toy-record button").forEach((btn) => {
    let timer = 0;
    btn.disabled = false;
    btn.addEventListener("click", () => {
      const on = btn.getAttribute("aria-pressed") !== "true";
      btn.setAttribute("aria-pressed", String(on));
      clearInterval(timer);
      if (!on || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      timer = window.setInterval(() => {
        const n = document.createElement("span");
        n.className = "note";
        n.textContent = Math.random() < 0.5 ? "♪" : "♫";
        n.style.left = `${80 + Math.random() * 30}px`;
        n.style.setProperty("--dx", `${Math.random() * 30 - 15}px`);
        btn.appendChild(n);
        setTimeout(() => n.remove(), 1600);
      }, 500);
    });
  });
</script>

<style>
  .player { position: relative; background: none; border: 0; padding: 0; display: block; }
  button.player { cursor: pointer; }
  svg { width: 150px; height: 110px; display: block; }
  .disc { transform-box: fill-box; transform-origin: center; }
  .arm { transform-box: fill-box; transform-origin: 100% 0; transition: transform 0.4s; }
  [aria-pressed="true"] .disc { animation: spin 1.8s linear infinite; }
  [aria-pressed="true"] .arm { transform: rotate(22deg); }
  @keyframes spin { to { transform: rotate(360deg); } }
  .player :global(.note) { position: absolute; top: 6px; font-size: 18px; font-weight: 700; color: var(--pop); pointer-events: none; animation: note 1.6s ease-out forwards; }
  @keyframes note { to { transform: translate(var(--dx), -50px) rotate(20deg); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { [aria-pressed="true"] .disc { animation: none; } .arm { transition: none; } }
</style>
