---
interface Props { inert?: boolean }
const { inert = false } = Astro.props;
const swatches = ["#8AB4FF", "#FFC857", "#0B7A75", "#FF6B4A"];
const areas = [
  { n: 1, d: "M0 0H190V130H0Z", tx: 18, ty: 22, label: "Sky" },
  { n: 2, d: "M160 44a20 20 0 1 1-40 0a20 20 0 1 1 40 0Z", tx: 137, ty: 48, label: "Sun" },
  { n: 3, d: "M0 90Q50 60 100 84T190 74V130H0Z", tx: 40, ty: 100, label: "Far hill" },
  { n: 4, d: "M0 112Q70 92 130 108T190 104V130H0Z", tx: 92, ty: 124, label: "Near hill" },
];
---
<div class="toy-paint">
  <svg viewBox="0 0 190 130" role={inert ? undefined : "group"} aria-label={inert ? undefined : "Paint by numbers"} aria-hidden={inert ? "true" : undefined}>
    {areas.map((a) => (
      <path class="area" d={a.d} fill="#ffffff" data-label={`Area ${a.n}: ${a.label}`} />
    ))}
    {areas.map((a) => <text x={a.tx} y={a.ty} aria-hidden="true">{a.n}</text>)}
  </svg>
  {!inert && (
    <div class="swatches" role="group" aria-label="Colours">
      {swatches.map((c, i) => (
        <button class="swatch" type="button" disabled aria-pressed={i === 0 ? "true" : "false"} aria-label={`Colour ${i + 1}`} data-colour={c} style={`background:${c}`}></button>
      ))}
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>(".toy-paint").forEach((root) => {
    const swatches = [...root.querySelectorAll<HTMLButtonElement>(".swatch")];
    if (!swatches.length) return;
    let colour = swatches[0].dataset.colour!;
    swatches.forEach((s) => {
      s.disabled = false;
      s.addEventListener("click", () => {
        colour = s.dataset.colour!;
        swatches.forEach((o) => o.setAttribute("aria-pressed", String(o === s)));
      });
    });
    root.querySelectorAll<SVGPathElement>(".area").forEach((area) => {
      area.setAttribute("tabindex", "0");
      area.setAttribute("role", "button");
      area.setAttribute("aria-label", area.dataset.label!);
      const fill = () => area.setAttribute("fill", colour);
      area.addEventListener("click", fill);
      // The brush paints as a mouse passes over an area.
      area.addEventListener("pointerenter", (e) => { if (e.pointerType !== "touch") fill(); });
      area.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); fill(); }
      });
    });
  });
</script>

<style>
  .toy-paint { display: grid; justify-items: center; gap: 8px; }
  svg { width: 190px; height: 130px; border: 3px solid var(--ink); border-radius: 8px; background: #fff; display: block; }
  .area { stroke: #0F2A2E; stroke-width: 2; transition: fill 0.25s; }
  .area[role="button"] { cursor: pointer; }
  .area:focus-visible { outline: none; stroke: var(--pop); stroke-width: 4; }
  text { font-size: 10px; font-weight: 700; fill: #48646a; pointer-events: none; }
  .swatches { display: flex; gap: 8px; }
  .swatch { width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--ink); padding: 0; cursor: pointer; }
  .swatch[aria-pressed="true"] { outline: 3px solid var(--ink); outline-offset: 2px; }
  :global(.room-toy.linked) .area:hover { fill: #FFC857; }
  @media (prefers-reduced-motion: reduce) { .area { transition: none; } }
</style>
