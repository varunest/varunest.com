---
const servers = ["nas", "agents", "media"];
---
<div class="rack-toy">
  <div class="stage">
    <div class="rack">
      {servers.map((name) => (
        <button class="srv" type="button" disabled data-name={name}>
          <i></i><i></i>{name}<span class="state">up</span>
        </button>
      ))}
    </div>
  </div>
  <p class="status" aria-live="polite"></p>
</div>

<script>
  const RESTART_MS = 1600;
  const root = document.querySelector<HTMLElement>(".rack-toy");
  const status = root?.querySelector<HTMLElement>(".status");
  root?.querySelectorAll<HTMLButtonElement>(".srv").forEach((btn) => {
    btn.disabled = false;
    const state = btn.querySelector<HTMLElement>(".state")!;
    btn.addEventListener("click", () => {
      if (btn.classList.contains("boot")) return;
      const name = btn.dataset.name;
      btn.classList.add("boot");
      state.textContent = "restarting";
      if (status) status.textContent = `${name} restarting`;
      setTimeout(() => {
        btn.classList.remove("boot");
        state.textContent = "up";
        if (status) status.textContent = `${name} up`;
      }, RESTART_MS);
    });
  });
</script>

<style>
  .stage { display: grid; place-items: center; height: 150px; border-radius: 10px; background: var(--bg); }
  .rack { display: grid; gap: 7px; width: 78%; }
  .srv {
    height: 34px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 10px;
    border: var(--stroke) solid var(--ink);
    border-radius: 6px;
    background: var(--card);
    color: var(--soft);
    font: 600 12px var(--body);
    cursor: pointer;
  }
  :global(.no-js) .srv { cursor: default; }
  i { width: 9px; height: 9px; border-radius: 50%; background: #1fa971; }
  i + i { animation: blink 1.4s infinite; }
  .boot i { background: var(--pop); animation: blink 0.25s infinite; }
  .state { margin-left: auto; }
  .status { min-height: 1.4em; margin: 8px 0 0; font-size: 14px; color: var(--soft); }
  @keyframes blink { 50% { opacity: 0.25; } }
  @media (prefers-reduced-motion: reduce) { i + i, .boot i { animation: none; } }
</style>
