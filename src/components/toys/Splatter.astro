---
// The Studio's toy: a small abstract painting that a hovering mouse splatters with paint.
// Taps splat where you tap, the keyboard flicks a few at random, and old splats make way
// for new ones so the canvas never turns to mud.
interface Props { inert?: boolean }
const { inert = false } = Astro.props;
const Tag = inert ? "span" : "button";
const clip = `splatter-${Math.random().toString(36).slice(2, 8)}`;
const INK = "#0F2A2E";
---
<div class="toy-splatter">
  <Tag class="easel" type={inert ? undefined : "button"} disabled={inert ? undefined : true} aria-label={inert ? undefined : "Splatter paint on the canvas"}>
    <svg viewBox="0 0 190 130" aria-hidden="true">
      <defs><clipPath id={clip}><rect x="6" y="6" width="178" height="118" rx="3" /></clipPath></defs>
      <rect class="board" x="6" y="6" width="178" height="118" rx="3" fill="#fbf8f2" />
      <g clip-path={`url(#${clip})`}>
        <g class="art" stroke={INK} stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
          <path d="M-4 96 L70 70 L92 128 L-4 140Z" fill="#0B7A75" />
          <circle cx="132" cy="44" r="25" fill="#FFC857" />
          <path d="M86 112 L118 58 L150 112Z" fill="#FF6B4A" />
          <path d="M18 34 C30 14 62 16 64 36 C66 56 36 62 26 52 C20 46 12 44 18 34Z" fill="#8AB4FF" />
          <path d="M150 120 A30 30 0 0 1 196 84" fill="none" stroke="#E9A6C2" stroke-width="9" />
          <path d="M150 120 A30 30 0 0 1 196 84" fill="none" />
          <path d="M70 22 L104 46 M44 112 L64 84" fill="none" />
          <circle cx="102" cy="22" r="4" fill={INK} />
          <circle cx="170" cy="20" r="3" fill={INK} />
        </g>
        <g class="splats"></g>
      </g>
      <rect x="6" y="6" width="178" height="118" rx="3" fill="none" stroke={INK} stroke-width="3" />
    </svg>
  </Tag>
</div>

<script>
  const NS = "http://www.w3.org/2000/svg";
  const PALETTE = ["#FF6B4A", "#FFC857", "#0B7A75", "#8AB4FF", "#E9A6C2", "#0F2A2E"];
  const MAX_SPLATS = 60;
  const BOARD = { x: 6, y: 6, w: 178, h: 118 };
  const calm = matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>(".toy-splatter").forEach((root) => {
    if (root.closest(".room-toy.inert")) return; // dim rooms stay still
    const easel = root.querySelector<HTMLElement>(".easel")!;
    const svg = root.querySelector<SVGSVGElement>("svg")!;
    const layer = root.querySelector<SVGGElement>(".splats")!;
    if (easel instanceof HTMLButtonElement) easel.disabled = false;

    const toLocal = (cx: number, cy: number) => {
      const m = svg.getScreenCTM();
      if (!m) return null;
      const p = new DOMPoint(cx, cy).matrixTransform(m.inverse());
      const inside = p.x >= BOARD.x && p.x <= BOARD.x + BOARD.w && p.y >= BOARD.y && p.y <= BOARD.y + BOARD.h;
      return inside ? p : null;
    };
    const dot = (g: SVGGElement, x: number, y: number, r: number) => {
      const c = document.createElementNS(NS, "circle");
      c.setAttribute("cx", x.toFixed(1)); c.setAttribute("cy", y.toFixed(1)); c.setAttribute("r", r.toFixed(1));
      g.appendChild(c);
    };
    const splat = (x: number, y: number) => {
      const g = document.createElementNS(NS, "g");
      g.setAttribute("class", calm.matches ? "splat" : "splat pop");
      g.setAttribute("fill", PALETTE[Math.floor(Math.random() * PALETTE.length)]);
      dot(g, x, y, 4 + Math.random() * 3);
      for (let i = 0, n = 5 + Math.floor(Math.random() * 3); i < n; i++) {
        const a = Math.random() * Math.PI * 2, d = 5 + Math.random() * 9;
        dot(g, x + Math.cos(a) * d, y + Math.sin(a) * d, 1 + Math.random() * 2);
      }
      layer.appendChild(g);
      while (layer.childElementCount > MAX_SPLATS) layer.firstElementChild!.remove();
    };

    // A hovering mouse flicks paint as it moves (a few times a second, not every pixel).
    let last = 0;
    easel.addEventListener("pointermove", (e) => {
      if (e.pointerType === "touch" || e.timeStamp - last < 70) return;
      const p = toLocal(e.clientX, e.clientY);
      if (!p) return;
      last = e.timeStamp;
      splat(p.x, p.y);
    });
    // Taps splat where you tap; the keyboard flicks a few at random. (On the home page the
    // toy sits inside a link, so a click there just goes into the room.)
    easel.addEventListener("click", (e) => {
      if (!(easel instanceof HTMLButtonElement)) return;
      const type = (e as PointerEvent).pointerType;
      if (type === "touch" || type === "pen") {
        const p = toLocal(e.clientX, e.clientY);
        if (p) splat(p.x, p.y);
      } else if (!type) {
        for (let i = 0; i < 3; i++) splat(BOARD.x + 12 + Math.random() * (BOARD.w - 24), BOARD.y + 12 + Math.random() * (BOARD.h - 24));
      }
    });
  });
</script>

<style>
  .toy-splatter { display: grid; justify-items: center; }
  .easel { display: block; padding: 0; border: 0; background: none; cursor: crosshair; }
  .easel svg { display: block; width: 190px; height: auto; }
  .easel:focus-visible { outline: 3px solid var(--ink); outline-offset: 4px; border-radius: 6px; }
  button.easel:disabled { cursor: default; }
  svg :global(.splat.pop) { transform-box: fill-box; transform-origin: center; animation: splat-in 0.22s ease-out; }
  @keyframes splat-in { from { transform: scale(0.2); opacity: 0.4; } }
</style>
