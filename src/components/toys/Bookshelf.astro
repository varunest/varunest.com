---
interface Props { inert?: boolean }
const { inert = false } = Astro.props;
const books = [
  { colour: "#0B7A75", h: 78 },
  { colour: "#FF6B4A", h: 62 },
  { colour: "#FFC857", h: 86 },
  { colour: "var(--card)", h: 70 },
  { colour: "#8AB4FF", h: 58 },
];
---
<div class="toy-bookshelf">
  <div class="shelf">
    {books.map((b, i) =>
      inert ? (
        <span class="book"><span class="spine" style={`height:${b.h}px;background:${b.colour}`}></span></span>
      ) : (
        <button class="book" type="button" disabled aria-pressed="false" aria-label={`Pull out book ${i + 1}`}>
          <span class="spine" style={`height:${b.h}px;background:${b.colour}`}></span>
        </button>
      ),
    )}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".toy-bookshelf").forEach((root) => {
    const books = [...root.querySelectorAll<HTMLButtonElement>("button.book")];
    const lift = (btn: HTMLButtonElement | null) => books.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
    books.forEach((btn) => {
      btn.disabled = false;
      btn.addEventListener("click", (e) => {
        // A mouse has already lifted this book by hovering, so its click keeps it up;
        // taps and the keyboard toggle it.
        const mouse = (e as PointerEvent).pointerType === "mouse";
        lift(!mouse && btn.getAttribute("aria-pressed") === "true" ? null : btn);
      });
      // A hovering mouse lifts the book under it (taps are handled by click).
      btn.addEventListener("pointerenter", (e) => { if (e.pointerType !== "touch") lift(btn); });
    });
    root.addEventListener("pointerleave", (e) => { if (e.pointerType !== "touch") lift(null); });
  });
</script>

<style>
  .shelf { display: flex; align-items: flex-end; gap: 5px; height: 96px; padding: 0 10px; border-bottom: 4px solid var(--ink); }
  /* The .book is a still hit area; only the drawn .spine inside it lifts, so hovering a
     book's edge can't move the book out from under the pointer and make it flicker. */
  .book { display: flex; align-items: flex-end; width: 22px; height: 96px; padding: 0; border: 0; background: none; }
  .spine { display: block; width: 100%; box-sizing: border-box; border: 2px solid var(--ink); border-radius: 3px 3px 0 0; transition: transform 0.25s cubic-bezier(0.3, 1.8, 0.5, 1); }
  button.book { cursor: pointer; }
  button.book:disabled { cursor: default; }
  .book[aria-pressed="true"] .spine { transform: translateY(-14px) rotate(-6deg); }
  :global(.room-toy.linked) .book:hover .spine { transform: translateY(-14px) rotate(-6deg); }
  @media (prefers-reduced-motion: reduce) { .spine { transition: none; } }
</style>
