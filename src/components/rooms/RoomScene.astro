---
import type { Room } from "../../lib/rooms";

interface Props {
  room: Room;
  blurb: string;
}
const { room, blurb } = Astro.props;
---
<section class="scene" style={`--c:${room.colour}`} aria-labelledby="room-h">
  <div class="lamp" aria-hidden="true"><div class="glow"></div></div>
  <div class="sign">
    <p class="crumb"><a href="/#rooms">Home</a> / {room.name}</p>
    <h1 id="room-h">{room.name}</h1>
    <p class="blurb">{blurb}</p>
  </div>
  <div class="stand">
    <div class="on"><slot name="toy" /></div>
    <div class="top" aria-hidden="true"></div>
    <div class="legs" aria-hidden="true"></div>
  </div>
  <div class="skirting" aria-hidden="true"></div>
  <div class="boards" aria-hidden="true"></div>
</section>

<style>
  .scene {
    position: relative; height: 370px; margin: 8px 0 40px; border-radius: 18px; overflow: hidden;
    border: 2px solid var(--ink);
    background:
      radial-gradient(circle, color-mix(in srgb, var(--c) 30%, transparent) 1.5px, transparent 2px) 0 0 / 22px 22px,
      linear-gradient(color-mix(in srgb, var(--c) 22%, var(--bg)), color-mix(in srgb, var(--c) 10%, var(--bg)));
  }
  .skirting { position: absolute; left: 0; right: 0; bottom: 62px; height: 10px; background: color-mix(in srgb, var(--ink) 80%, var(--c)); }
  .boards {
    position: absolute; left: 0; right: 0; bottom: 0; height: 62px;
    background: repeating-linear-gradient(90deg, color-mix(in srgb, #c7975c 70%, var(--bg)) 0 90px, color-mix(in srgb, #b5854b 70%, var(--bg)) 90px 92px);
  }
  :global([data-theme="dark"]) .boards { background: repeating-linear-gradient(90deg, #3a2f25 0 90px, #2b231b 90px 92px); }
  .sign {
    position: absolute; left: 44px; top: 48px; max-width: 420px; z-index: 1;
    background: var(--card); border: 3px solid var(--ink); border-radius: 10px; padding: 14px 20px 16px;
    box-shadow: 0 5px 0 var(--ink);
  }
  .sign::before, .sign::after { content: ""; position: absolute; top: -50px; width: 2px; height: 50px; background: var(--ink); }
  .sign::before { left: 30%; }
  .sign::after { right: 30%; }
  .crumb { margin: 0; font-size: 14px; color: var(--soft); }
  h1 { margin: 2px 0 0; font-size: clamp(34px, 5vw, 46px); line-height: 1.05; }
  .blurb { margin: 6px 0 0; color: var(--soft); font-size: 16px; }
  .stand { position: absolute; right: 80px; bottom: 62px; display: grid; justify-items: center; z-index: 1; }
  .stand .on { padding-bottom: 6px; }
  .stand .top { width: 260px; height: 14px; border-radius: 4px; background: color-mix(in srgb, var(--ink) 85%, #8b6d47); }
  .stand .legs {
    width: 220px; height: 60px;
    border-left: 10px solid color-mix(in srgb, var(--ink) 85%, #8b6d47);
    border-right: 10px solid color-mix(in srgb, var(--ink) 85%, #8b6d47);
  }
  /* Hangs on a short cord over the middle of the stand (right: 80px + half of 260px). */
  .lamp { position: absolute; right: 209px; top: 0; width: 2px; height: 14px; background: var(--ink); }
  .lamp::after {
    content: ""; position: absolute; left: -26px; top: 14px; width: 54px; height: 28px;
    background: var(--pop2); border: 3px solid var(--ink); border-radius: 30px 30px 4px 4px;
  }
  /* The glow hangs from the lamp itself, so it always sits centred under the shade. */
  .glow {
    position: absolute; left: 1px; top: 48px; width: 300px; height: 260px; transform: translateX(-50%);
    pointer-events: none; background: radial-gradient(ellipse at top, rgba(255, 210, 122, 0.32), transparent 70%);
  }
  :global([data-theme="dark"]) .glow { background: radial-gradient(ellipse at top, rgba(255, 210, 122, 0.45), transparent 70%); }
  @media (max-width: 900px) {
    .scene { height: auto; padding: 56px 20px 72px; display: grid; gap: 26px; justify-items: center; }
    .sign { position: relative; left: 0; top: 0; justify-self: stretch; max-width: none; }
    .stand { position: relative; right: auto; bottom: auto; }
    .stand .legs { display: none; }
    .lamp { display: none; }
  }
</style>
