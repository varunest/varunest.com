---
import { formatDate, postUrl, type Post } from "../../lib/posts";
import { roomById, roomUrl } from "../../lib/rooms";

interface Props {
  posts: Post[];
  showRoom?: boolean;
  headingLevel?: 2 | 3;
}
const { posts, showRoom = false, headingLevel = 3 } = Astro.props;
const H: any = headingLevel === 2 ? "h2" : "h3";
---
<ul class="rows">
  {posts.map((p) => {
    const room = roomById(p.data.room);
    return (
      <li class="row">
        <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
        <div>
          <H class="title"><a href={postUrl(p)}>{p.data.title}</a></H>
          <p>{p.data.summary}</p>
        </div>
        {showRoom && (
          <a class="room-chip" href={roomUrl(room.id)} style={`--c:${room.colour}`}>{room.name.replace(/^The /, "")}</a>
        )}
      </li>
    );
  })}
</ul>

<style>
  .rows { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid; grid-template-columns: 130px 1fr auto; gap: 18px; align-items: baseline;
    padding: 16px 0; border-bottom: 1px solid var(--line);
  }
  time { color: var(--soft); font-size: 15px; }
  .title { font-size: 21px; margin: 0 0 2px; }
  .title a { color: var(--ink); text-decoration: none; }
  .title a:hover { text-decoration: underline; text-underline-offset: 4px; }
  p { margin: 0; color: var(--soft); font-size: 16px; }
  .room-chip {
    font-size: 13px; font-weight: 700; padding: 1px 10px; border-radius: 99px; white-space: nowrap;
    border: 1.5px solid var(--ink); color: var(--ink); text-decoration: none;
    background: color-mix(in srgb, var(--c) 35%, var(--card));
  }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; gap: 6px; } .room-chip { justify-self: start; } }
</style>
