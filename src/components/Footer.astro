---
import { SITE } from "../lib/site";
---
<footer class="site-footer">
  <div class="wrap">
    <h2>Get in touch</h2>
    <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    <ul>
      <li><a href={SITE.social.github}>GitHub</a></li>
      <li><a href={SITE.social.linkedin}>LinkedIn</a></li>
      <li><a href={SITE.social.x}>X</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { margin-top: 60px; padding: 40px 0 50px; border-top: 2px dashed var(--line); }
  h2 { font-size: 1.5rem; }
  ul { display: flex; gap: 22px; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  a { font-weight: 600; }
</style>
