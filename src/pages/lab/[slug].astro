---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import Toy from "../../components/Toy.astro";
import { formatDate } from "../../lib/posts";
import { resolveToy } from "../../lib/toy";
import { getPublishedLab, labUrl } from "../../lib/lab";

export const getStaticPaths = (async () => {
  const entries = await getPublishedLab();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const toy = resolveToy(entry.data);
const { Content } = await render(entry);
---
<Base title={`${entry.data.title} | Lab | Varun Verma`} description={entry.data.summary} path={labUrl(entry.id)} showLab={true}>
  <article class="wrap">
    <h1>{entry.data.title}</h1>
    <p class="meta"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></p>
    {(entry.data.repo || entry.data.demo) && (
      <p>
        {entry.data.repo && <a class="btn alt" href={entry.data.repo}>Source</a>}
        {entry.data.demo && <a class="btn alt" href={entry.data.demo}>Demo</a>}
      </p>
    )}
    {entry.data.cover && <Image class="cover" src={entry.data.cover} alt={entry.data.title} widths={[480, 760]} sizes="(max-width: 760px) 100vw, 760px" />}
    {toy && <Toy name={toy} context={{ title: entry.data.title }} />}
    <Content />
  </article>
</Base>

<style>
  .wrap { max-width: var(--content); margin: 0 auto; padding: 40px 24px 64px; }
  .cover { width: 100%; height: auto; border-radius: var(--radius); margin: 0 0 24px; }
  .meta { color: var(--soft); font-size: 0.9rem; }
</style>
