---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/posts";
import { getPublishedLab, labIndexPaths } from "../../lib/lab";

export const getStaticPaths = (async () => {
  const entries = await getPublishedLab();
  return labIndexPaths(entries).map((p) => ({ ...p, props: { entries } }));
}) satisfies GetStaticPaths;

const { entries } = Astro.props;
---
<Base title="Lab | Varun Verma" description="Experiments, prototypes and small machines." path="/lab/" showLab={true}>
  <section class="wrap">
    <h1>Lab</h1>
    <ul class="list">
      {entries.map((e) => (
        <li class="card">
          <h2><a href={`/lab/${e.id}/`}>{e.data.title}</a></h2>
          <p class="meta"><time datetime={e.data.date.toISOString()}>{formatDate(e.data.date)}</time></p>
          <p>{e.data.summary}</p>
          <p>{e.data.tags.map((t) => <span class="tag">{t}</span>)}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .wrap { max-width: 760px; margin: 0 auto; padding: 40px 20px 64px; }
  .list { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 16px; }
  h2 { margin: 0 0 4px; font-size: 1.25rem; }
  .meta { margin: 0 0 8px; opacity: 0.8; font-size: 0.9rem; }
  p { margin: 0 0 8px; }
  .tag { margin-right: 6px; }
</style>
