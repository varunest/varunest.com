---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import LabCards from "../../components/LabCards.astro";
import { getPublishedLab, labIndexPaths, labUrl } from "../../lib/lab";

export const getStaticPaths = (async () => {
  const entries = await getPublishedLab();
  return labIndexPaths(entries).map((p) => ({ ...p, props: { entries } }));
}) satisfies GetStaticPaths;

const { entries } = Astro.props;
---
<Base title="Lab | Varun Verma" description="Experiments, prototypes and small machines." path={labUrl()} showLab={true}>
  <section class="wrap">
    <h1>Lab</h1>
    <LabCards entries={entries} headingLevel={2} />
  </section>
</Base>

<style>
  .wrap { max-width: var(--content); margin: 0 auto; padding: 40px 24px 64px; }
</style>
