---
import Base from "../../layouts/Base.astro";
import { formatDate, getPublishedPosts, postUrl } from "../../lib/posts";

const posts = await getPublishedPosts();
---
<Base title="Writing | Varun Verma" description="Posts by Varun Verma on software, investing, books and art." path="/blog/">
  <section class="wrap">
    <h1>Writing</h1>
    <ul class="list">
      {posts.map((p) => (
        <li class="card">
          <h2><a href={postUrl(p.id)}>{p.data.title}</a></h2>
          <p class="meta"><time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time></p>
          <p>{p.data.summary}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .wrap { max-width: 760px; margin: 0 auto; padding: 40px 20px 64px; }
  .list { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 16px; }
  h2 { margin: 0 0 4px; font-size: 1.25rem; }
  .meta { margin: 0 0 8px; opacity: 0.8; font-size: 0.9rem; }
  p { margin: 0 0 8px; }
</style>
