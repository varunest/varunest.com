---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Post from "../../layouts/Post.astro";
import Comments from "../../components/Comments.astro";
import Toy from "../../components/Toy.astro";
import { getPublishedPosts } from "../../lib/posts";
import { resolveToy } from "../../lib/toy";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const all = await getPublishedPosts();
const toy = resolveToy(post.data);
const context = {
  title: post.data.title,
  rating: post.data.rating,
  others: all
    .filter((p) => p.id !== post.id && p.data.tags.includes("book-review"))
    .map((p) => ({ title: p.data.title, rating: p.data.rating })),
};
const { Content } = await render(post);
---
<Post post={post} newer={newer} older={older}>
  {toy && <Toy slot="toy" name={toy} context={context} />}
  <Content />
  <Comments slot="comments" />
</Post>
