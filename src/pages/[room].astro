---
import type { GetStaticPaths } from "astro";
import Base from "../layouts/Base.astro";
import RoomScene from "../components/rooms/RoomScene.astro";
import PostRows from "../components/rooms/PostRows.astro";
import RoomToy from "../components/toys/RoomToy.astro";
import { books, getHouse } from "../lib/house";
import LibraryShelves from "../components/rooms/LibraryShelves.astro";
import { roomUrl } from "../lib/rooms";

export const getStaticPaths = (async () => {
  const house = await getHouse();
  return house.filter((r) => r.lit).map((room) => ({ params: { room: room.id }, props: { room } }));
}) satisfies GetStaticPaths;

const { room } = Astro.props;
const BLURBS: Record<string, string> = {
  library: "Books I've read, newest first. Click a book for my notes.",
  workshop: "Apps and libraries I've built and shipped.",
  studio: "Things I've drawn, hung on the wall.",
  vault: "Notes on money and investing.",
  "server-closet": "My home lab: servers, tools and what broke.",
  "living-room": "Everyday writing.",
};
---
<Base title={`${room.name} | Varun Verma`} description={`${room.blurb}: ${BLURBS[room.id]}`} path={roomUrl(room.id)}>
  <div class="wrap">
    <RoomScene room={room} blurb={BLURBS[room.id]}>
      <RoomToy slot="toy" toy={room.toy} />
    </RoomScene>
    {room.id === "library" && <LibraryShelves books={books} />}
    {room.posts.length > 0 && (
      <section class="room-posts" aria-labelledby="posts-h">
        <h2 id="posts-h" class:list={{ "sr-only": !["library", "workshop", "studio"].includes(room.id) }}>
          {room.id === "library" ? "Reviews on the blog" : `From ${room.name.replace(/^The /, "the ")}`}
        </h2>
        <PostRows posts={room.posts} headingLevel={2} />
      </section>
    )}
  </div>
</Base>

<style>
  .room-posts { margin: 40px 0 56px; }
  .room-posts h2 { font-size: 22px; margin: 0 0 8px; }
</style>
